+    def _return_to_datum(self) -> None:
+        """Drive pitch back to the board's stored home datum, if it has one.
+
+        NEVER FATAL. A board with no datum -- or firmware predating it --
+        homes exactly as it did before and says so. The pitch datum is then
+        "wherever levelling left us", which is the old behaviour: still a
+        datum, just not a repeatable one.
+        """
+        try:
+            reply = self._cmd("datum go", T_LEVEL)
+        except (HomingError, LinkError) as exc:
+            text = str(exc).lower()
+            if "unknown command" in text:
+                self._say("the board has no `datum` command: this firmware "
+                          "predates the stored home datum, so pitch is "
+                          "wherever levelling left it and will NOT come back "
+                          "to the same pose after a reset.", 0.93)
+            elif "no datum stored" in text:
+                self._say("no home datum stored on the board. Pitch will not "
+                          "return to the same pose next boot -- put the "
+                          "payload where home should be and run `datum set` "
+                          "once.", 0.93)
+            else:
+                # A real failure of a real mechanism. Loud, but not fatal:
+                # this run still has a gravity pitch datum and a yaw datum.
+                self._say("could NOT return to the home datum (%s). The datum "
+                          "this run sets is the pose levelling reached, not "
+                          "stored home." % exc, 0.93)
+            return
+        m = re.search(r"returned to the HOME DATUM:\s+" + _NUM + r"\s+deg",
+                      reply or "")
+        if m:
+            self._say("returned to the stored home datum: %.2f deg from it"
+                      % float(m.group(1)), 0.93)
+        else:
+            self._say("`datum go` completed but reported no residual; "
+                      "treating the return as unconfirmed.", 0.93)
 
