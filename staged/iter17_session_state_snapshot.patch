     # -- lifecycle ---------------------------------------------------------
+    def snapshot_state(self, label: str) -> None:
+        """Record the BOARD's own view of the world under `label`.
+
+        Two of these bracket a run. Between them sits every number the AAR
+        argues about, and until now none of them could be checked against
+        what the firmware thought: the recorder logged what the host asked
+        for and what the IMU saw, and nothing about the board's own pose,
+        clamp or guard. On run_2026-09-20_184448 the step-count clamp
+        refused pitch for 7 s on a count 70 deg wrong, and no field in the
+        recording could show it.
+
+        MUST BE CALLED ON AN IDLE BOARD. link.state() is SETUP ONLY --
+        _require_idle refuses it while the servo path is active, by design,
+        because there is no version of it that is safe while servoing. A
+        refusal is stored as the reason rather than raised: a snapshot is a
+        diagnostic, and one that can abort a shutdown is worse than none.
+        """
+        if self.link is None:
+            self._state_snaps[label] = {"error": "no link (sim run)"}
+            return
+        try:
+            st = self.link.state()
+            self._state_snaps[label] = {
+                "t": time.perf_counter() - self.t0,
+                "payload": st.get("payload"),
+                "velocity": st.get("velocity"),
+                "guard": st.get("guard"),
+                "datum": st.get("datum"),
+                "axes": {n: {"position": a.get("position"),
+                             "microstep": a.get("microstep"),
+                             "mode": a.get("mode")}
+                         for n, a in (st.get("axes") or {}).items()},
+            }
+        except Exception as exc:                           # noqa: BLE001
+            self._state_snaps[label] = {"error": "%s: %s"
+                                        % (type(exc).__name__, exc)}
+
+    def rewrite_session(self) -> None:
+        """Re-emit session.json. For a snapshot taken after close().
+
+        The end snapshot cannot happen at close() -- see snapshot_state --
+        so the file is written once there and refreshed here.
+        """
+        try:
+            self._write_session()
+        except Exception:                                  # noqa: BLE001
+            pass
+
     def start(self) -> "FlightRecorder":
