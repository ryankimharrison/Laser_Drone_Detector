+def _microstep(link) -> Optional[int]:
+    """The divisor BOTH axes are on, or None if they disagree or are unknown.
+
+    None on disagreement rather than a guess: the differential transform
+    assumes the two motors share a divisor, so a mismatch means every angle
+    derived from these counts is wrong and the datum has to say so instead
+    of picking one.
+    """
+    try:
+        st = link.state()
+        vals = {int(a["microstep"]) for a in st.get("axes", {}).values()
+                if a.get("microstep") is not None}
+        return vals.pop() if len(vals) == 1 else None
+    except Exception:                                      # noqa: BLE001
+        return None
+
+
 def capture(link, level_ok: Optional[bool] = None) -> Optional[dict]:
     """Note the datum. Call AFTER homing, with the platform stationary.
 
